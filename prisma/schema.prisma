// SAJI Platform — Database Schema
// Reconciles ~15+ duplicate/conflicting mock-data shapes found across the frontend
// (see conversation history for the per-portal inventory this was derived from)
// into one canonical, normalized model per entity.
//
// Stack: PostgreSQL (hosted on Supabase) + Prisma ORM + Auth.js (NextAuth v5)

generator client {
  provider = "prisma-client-js"
  // "native" covers whatever OS runs `prisma generate` (this dev machine is
  // Windows) — the rest are the common Linux shared-hosting variants, so the
  // query engine that ships to HostPinnacle actually runs there. Confirm the
  // exact OS/OpenSSL version with HostPinnacle support and trim this list
  // once known; shipping a few extra binaries costs generate time/disk, not
  // correctness.
  binaryTargets = ["native", "debian-openssl-3.0.x", "debian-openssl-1.1.x", "rhel-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

