// =========================================================================
// MESSAGING
// Reconciles: per-portal chat mocks that either discarded messages
// (secretary/messages), mutated a module-level object instead of React
// state (admin/messages), or weren't keyed by conversation at all
// (shopkeeper/messages) — one real Conversation/Message model for everyone.
// =========================================================================

model Conversation {
  id             String    @id @default(cuid())
  participantAId String
  participantBId String
  jobId          String?   @unique
  lastMessageAt  DateTime?
  isArchived     Boolean   @default(false)
  createdAt      DateTime  @default(now())

  participantA User      @relation("ConversationParticipantA", fields: [participantAId], references: [id])
  participantB User      @relation("ConversationParticipantB", fields: [participantBId], references: [id])
  job          Job?      @relation(fields: [jobId], references: [id])
  messages     Message[]
  callSignals  CallSignal[]

  @@unique([participantAId, participantBId, jobId])
  @@index([participantAId])
  @@index([participantBId])
  @@map("conversations")
}

model Message {
  id              String      @id @default(cuid())
  conversationId  String
  senderId        String
  type            MessageType @default(TEXT)
  content         String?
  attachmentUrl   String?
  isRead          Boolean     @default(false)
  readAt          DateTime?
  relatedStatusId String?
  createdAt       DateTime    @default(now())

  conversation   Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User            @relation("MessageSender", fields: [senderId], references: [id])
  relatedStatus  ProviderStatus? @relation("MessageRelatedStatus", fields: [relatedStatusId], references: [id], onDelete: SetNull)

  @@index([conversationId])
  @@index([senderId])
  @@map("messages")
}

// Ephemeral WebRTC signaling rows (SDP offers/answers, ICE candidates, ring/
// hangup/reject events) for real-time voice calls between two conversation
// participants. Polled (short interval) rather than pushed since this app
// has no persistent WebSocket server — same reasoning as the 5s message
// poll, just faster because call setup is latency-sensitive. Rows are
// short-lived: cleared once a call ends (see clearCallSignals).
model CallSignal {
  id             String   @id @default(cuid())
  conversationId String
  fromUserId     String
  toUserId       String
  type           String
  payload        Json
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([toUserId])
  @@map("call_signals")
}

// =========================================================================
// NOTIFICATIONS
// =========================================================================

model Notification {
  id          String           @id @default(cuid())
  userId      String
  title       String
  message     String
  type        NotificationType
  relatedType String?
  relatedId   String?
  actionUrl   String?
  isRead      Boolean          @default(false)
  createdAt   DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}

// =========================================================================
// DISPUTES
// Reconciles: agent/page.tsx and agent/disputes/page.tsx independently
// mocked the *same* dispute IDs (DSP-001..003) with different field sets.
// =========================================================================

model Dispute {
  id            String          @id @default(cuid())
  disputeNumber String          @unique
  jobId         String?
  orderId       String?
  customerId    String
  providerId    String?
  reason        String
  description   String
  status        DisputeStatus   @default(OPEN)
  severity      DisputeSeverity @default(MEDIUM)
  assignedToId  String?
  refundAmount  Decimal?        @db.Decimal(14, 2)
  resolution    String?
  photos        String[]        @default([])
  createdAt     DateTime        @default(now())
  resolvedAt    DateTime?

  job        Job?             @relation(fields: [jobId], references: [id])
  order      Order?           @relation(fields: [orderId], references: [id])
  customer   User             @relation("DisputeCustomer", fields: [customerId], references: [id])
  provider   ProviderProfile? @relation("DisputeProvider", fields: [providerId], references: [id])
  assignedTo User?            @relation("DisputeAssignee", fields: [assignedToId], references: [id])
  messages   DisputeMessage[]

  @@index([customerId])
  @@index([providerId])
  @@index([status])
  @@map("disputes")
}

model DisputeMessage {
  id          String   @id @default(cuid())
  disputeId   String
  senderId    String
  message     String
  attachments String[]
  createdAt   DateTime @default(now())

  dispute Dispute @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  sender  User    @relation(fields: [senderId], references: [id])

  @@index([disputeId])
  @@map("dispute_messages")
}

// =========================================================================
// TEAM / ADMIN OPERATIONS
// Reconciles: commission concept fragmented across admin/commissions,
// admin/pricing, and admin/settings' paymentRules into one Tier model.
// =========================================================================

model CommissionTier {
  id            String           @id @default(cuid())
  name          String
  role          CommissionRole
  rate          Decimal          @db.Decimal(5, 2) // percentage
  minJobs       Int?
  minAmount     Decimal?         @db.Decimal(14, 2)
  maxAmount     Decimal?         @db.Decimal(14, 2)
  status        CommissionStatus @default(ACTIVE)
  effectiveFrom DateTime         @default(now())
  effectiveTo   DateTime?
  createdById   String
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  createdBy User @relation(fields: [createdById], references: [id])

  @@index([role])
  @@index([status])
  @@map("commission_tiers")
}

// Ledger of record for every commission deduction actually taken at
// settlement time (completeJob/checkout/placeWholesaleOrder). Kept separate
// from Payment (which never gets a payeeId for Job contexts and is never
// revisited by completeJob) so reversal paths can look up the exact
// commissionAmount/payoutAmount recorded here instead of recomputing a rate
// that may have changed since the order was placed.
model PlatformRevenue {
  id               String         @id @default(cuid())
  role             CommissionRole
  sourceType       String // "JOB" | "ORDER" | "WHOLESALE_ORDER"
  sourceId         String         @unique
  userId           String // the seller (provider/shopkeeper/distributor) who earned the gross amount
  grossAmount      Decimal        @db.Decimal(14, 2)
  rate             Decimal        @db.Decimal(5, 2) // percentage applied at settlement time
  commissionAmount Decimal        @db.Decimal(14, 2)
  payoutAmount     Decimal        @db.Decimal(14, 2)
  reversedAt       DateTime?
  createdAt        DateTime       @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([role])
  @@map("platform_revenue")
}

model Announcement {
  id          String               @id @default(cuid())
  title       String
  message     String
  audience    AnnouncementAudience @default(ALL)
  type        AnnouncementType     @default(GENERAL)
  status      AnnouncementStatus   @default(DRAFT)
  views       Int                  @default(0)
  startDate   DateTime             @default(now())
