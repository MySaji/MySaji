}

model OrderItem {
  id         String  @id @default(cuid())
  orderId    String
  productId  String
  quantity   Int
  unitPrice  Decimal @db.Decimal(12, 2)
  totalPrice Decimal @db.Decimal(12, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

// =========================================================================
// WALLET, PAYMENTS & TRANSACTIONS
// Reconciles: 3-4 independent, unsynced "wallet balance" useState instances
// found across the customer/provider portals into ONE real ledger.
// =========================================================================

model Wallet {
  id             String   @id @default(cuid())
  userId         String   @unique
  balance        Decimal  @default(0) @db.Decimal(14, 2)
  currency       String   @default("KES")
  totalEarned    Decimal  @default(0) @db.Decimal(14, 2)
  totalWithdrawn Decimal  @default(0) @db.Decimal(14, 2)
  pendingBalance Decimal  @default(0) @db.Decimal(14, 2)
  escrowBalance  Decimal  @default(0) @db.Decimal(14, 2)
  updatedAt      DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@map("wallets")
}

model Transaction {
  id            String            @id @default(cuid())
  walletId      String
  type          TransactionType
  amount        Decimal           @db.Decimal(14, 2)
  description   String
  referenceType String?
  referenceId   String?
  status        TransactionStatus @default(COMPLETED)
  balanceBefore Decimal           @db.Decimal(14, 2)
  balanceAfter  Decimal           @db.Decimal(14, 2)
  createdAt     DateTime          @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@index([type])
  @@index([createdAt])
  @@map("transactions")
}

// Mirrors Wallet/Transaction exactly (balance + auditable ledger) — the
// established shape in this codebase for "a balance plus a history."
// Points are earned on completed purchases/jobs and redeemed 1:1 for real
// Wallet credit (1 point = KES 1), never spent directly.
model LoyaltyAccount {
  id             String   @id @default(cuid())
  userId         String   @unique
  points         Int      @default(0)
  lifetimePoints Int      @default(0)
  updatedAt      DateTime @updatedAt

  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions LoyaltyTransaction[]

  @@map("loyalty_accounts")
}

model LoyaltyTransaction {
  id            String                 @id @default(cuid())
  accountId     String
  type          LoyaltyTransactionType
  points        Int
  description   String
  referenceType String?
  referenceId   String?
  balanceBefore Int
  balanceAfter  Int
  createdAt     DateTime               @default(now())

  account LoyaltyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@map("loyalty_transactions")
}

model PaymentMethod {
  id            String            @id @default(cuid())
  userId        String
  type          PaymentMethodType
  provider      String?
  accountNumber String // masked display value only, e.g. "***1234" — never the real number
  // AES-256-GCM ciphertext of the real destination (M-Pesa MSISDN today) —
  // the only place the real number is recoverable from, needed so B2C
  // payouts have somewhere real to send money to. Null for methods added
  // before this existed, or when PAYMENT_METHOD_ENCRYPTION_KEY isn't set;
  // those withdrawals just fall back to the manual payout flow.
  encryptedAccountNumber String?
  isDefault     Boolean           @default(false)
  isVerified    Boolean           @default(false)
  createdAt     DateTime          @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@index([userId])
  @@map("payment_methods")
}

model Payment {
  id              String             @id @default(cuid())
  amount          Decimal            @db.Decimal(14, 2)
  currency        String             @default("KES")
  status          PaymentStatus      @default(PENDING)
  contextType     PaymentContextType
  jobId           String?
  orderId         String?
  wholesaleOrderId String?
  rentalBookingId String?
  payerId         String
  payeeId         String?
  paymentMethodId String?
  externalRef     String? // M-Pesa receipt number / gateway transaction id
  // Human-readable reason a FAILED payment failed — e.g. "You cancelled the
  // M-Pesa payment" vs "Insufficient M-Pesa balance", mapped from Safaricom's
  // STK push ResultCode (see mpesaFailureReason in lib/actions/payments.ts).
  // Lets the UI say something more useful than one generic "payment failed".
  failureReason   String?
  createdAt       DateTime           @default(now())
  paidAt          DateTime?
  refundedAt      DateTime?

  job            Job?            @relation(fields: [jobId], references: [id])
  order          Order?          @relation(fields: [orderId], references: [id])
  wholesaleOrder WholesaleOrder? @relation(fields: [wholesaleOrderId], references: [id])
  rentalBooking  RentalBooking?  @relation(fields: [rentalBookingId], references: [id])
  payer          User            @relation("PaymentPayer", fields: [payerId], references: [id])
  payee          User?           @relation("PaymentPayee", fields: [payeeId], references: [id])
  paymentMethod  PaymentMethod?  @relation(fields: [paymentMethodId], references: [id])

  @@index([payerId])
  @@index([status])
  @@index([jobId])
  @@index([orderId])
  @@index([wholesaleOrderId])
  @@map("payments")
}

model WithdrawalRequest {
  id               String            @id @default(cuid())
  userId           String
  amount           Decimal           @db.Decimal(14, 2)
  method           PaymentMethodType
  recipientDetails Json
  status           WithdrawalStatus  @default(PENDING)
  rejectionReason  String?
  processingFee    Decimal           @default(0) @db.Decimal(12, 2)
  netAmount        Decimal           @db.Decimal(14, 2)
  externalRef      String?
  // Safaricom's ConversationID for an in-flight B2C payout — set the moment
  // the payout is dispatched, used to correlate the async result callback
  // back to this request. Null for manually-completed withdrawals.
  b2cConversationId String?          @unique
  createdAt        DateTime          @default(now())
  completedAt      DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("withdrawal_requests")
}

enum ReceiptType {
  PAYMENT
  DEPOSIT
  WITHDRAWAL
}

/// A snapshotted, downloadable/emailable receipt — covers a cart checkout
/// (possibly spanning several vendors), a standalone job-booking payment, a
/// wallet top-up, or a wallet withdrawal. `lineItems`/`subtotal`/`platformFee`
/// are frozen at creation time (a receipt must keep showing what was
/// actually charged, even if e.g. a product's name changes later) — but
/// the PDF's logo and contact footer are deliberately NOT stored here and
/// are re-read live from PlatformSetting at render time, so an admin
/// changing the support contact/logo updates every past receipt too, not
/// just future ones. `receiptNumber` is the public lookup key for the
/// no-login /verify page and QR code — has a random suffix, not a plain
/// increment, so receipts can't be enumerated by guessing.
model Receipt {
  id              String      @id @default(cuid())
  receiptNumber   String      @unique
  userId          String
  type            ReceiptType
  paymentMethod   String?
  transactionRef  String?
  lineItems       Json
  subtotal        Decimal?    @db.Decimal(14, 2)
  // Extra summary rows between Subtotal and Total — e.g. shipping,
  // promo-code discount. Deliberately NOT a "platform fee" line: this
  // app's checkout never charges the customer a visible fee, commission
  // is netted out of the vendor's payout instead, so a receipt must not
  // show a fee that wasn't actually charged. Shape: [{ label, amount }].
  adjustments     Json?
  totalAmount     Decimal     @db.Decimal(14, 2)
  currency        String      @default("KES")
  balanceAfter    Decimal?    @db.Decimal(14, 2)
  emailedTo       String?
  createdAt       DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("receipts")
}

// =========================================================================
// INVOICES & QUOTES (Provider-issued, secretary-tracked)
