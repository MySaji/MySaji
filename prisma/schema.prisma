  fromUserId String
  toUserId   String?
  toShopId   String?
  message    String
  createdAt  DateTime @default(now())

  fromUser User               @relation("EndorsementFrom", fields: [fromUserId], references: [id])
  toUser   User?              @relation("EndorsementTo", fields: [toUserId], references: [id])
  toShop   ShopkeeperProfile? @relation("EndorsementToShop", fields: [toShopId], references: [id])

  @@index([toUserId])
  @@index([toShopId])
  @@map("endorsements")
}

model Promotion {
  id           String          @id @default(cuid())
  shopkeeperId String
  name         String
  code         String          @unique
  type         PromotionType
  value        Decimal         @db.Decimal(10, 2)
  minOrder     Decimal         @default(0) @db.Decimal(12, 2)
  maxUses      Int?
  usedCount    Int             @default(0)
  startDate    DateTime
  endDate      DateTime?
  status       PromotionStatus @default(SCHEDULED)
  categoryId   String?
  description  String?
  createdAt    DateTime        @default(now())

  shopkeeper ShopkeeperProfile @relation(fields: [shopkeeperId], references: [id], onDelete: Cascade)
  category   Category?         @relation(fields: [categoryId], references: [id])

  @@index([shopkeeperId])
  @@index([status])
  @@map("promotions")
}

// =========================================================================
// COMMUNITY (Social feed — posts, likes, comments, follows, groups)
// =========================================================================

model Post {
  id           String   @id @default(cuid())
  authorId     String
  content      String
  images       String[]
  video        String?
  location     String?
  likeCount    Int      @default(0)
  commentCount Int      @default(0)
  shareCount   Int      @default(0)
  isPinned     Boolean  @default(false)
  isArchived   Boolean  @default(false)
  createdAt    DateTime @default(now())

  author   User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  likes    PostLike[]
  saves    PostSave[]
  comments PostComment[]

  @@index([authorId])
  @@index([createdAt])
  @@map("posts")
}

model PostLike {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
  @@map("post_likes")
}

model PostSave {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
  @@map("post_saves")
}

model PostComment {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  content   String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@map("post_comments")
}

// A provider's "before/after" status — WhatsApp-Status-style: shown in a
// circular ring on the customer home feed and gone 12 hours after posting.
// The 12h window is enforced by filtering on `createdAt` at read time (this
// project's cron infra is once-daily at finest, too coarse for a real-time
// expiry); a daily cron additionally hard-deletes rows past that window so
// they don't accumulate indefinitely.
model ProviderStatus {
  id          String   @id @default(cuid())
  providerId  String
  beforeImage String
  afterImage  String
  caption     String?
  likeCount   Int      @default(0)
  createdAt   DateTime @default(now())

  provider User                 @relation(fields: [providerId], references: [id], onDelete: Cascade)
  likes    ProviderStatusLike[]
  replies  Message[]            @relation("MessageRelatedStatus")

  @@index([providerId])
  @@index([createdAt])
  @@map("provider_statuses")
}

model ProviderStatusLike {
  id        String   @id @default(cuid())
  statusId  String
  userId    String
  createdAt DateTime @default(now())

  status ProviderStatus @relation(fields: [statusId], references: [id], onDelete: Cascade)
  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([statusId, userId])
  @@index([statusId])
  @@map("provider_status_likes")
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("FollowFollower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("FollowFollowing", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
  @@map("follows")
}

model BlockedClient {
  id         String   @id @default(cuid())
  providerId String
  customerId String
  reason     String?
  createdAt  DateTime @default(now())

  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  customer User            @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([providerId, customerId])
  @@index([providerId])
  @@map("blocked_clients")
}

model Group {
  id          String   @id @default(cuid())
  name        String
  description String?
  image       String?
  createdById String
  createdAt   DateTime @default(now())

  createdBy User              @relation(fields: [createdById], references: [id])
  members   GroupMembership[]
  posts     GroupPost[]

  @@map("groups")
}

model GroupMembership {
  id       String   @id @default(cuid())
  groupId  String
  userId   String
  isAdmin  Boolean  @default(false)
  joinedAt DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([groupId])
  @@map("group_memberships")
}

/// A group's own mini-feed — mirrors Post/PostLike/PostComment exactly, just
/// scoped to a groupId, so members have something real to do inside a group
/// beyond joining it (the group list previously had no content model at all).
model GroupPost {
  id           String   @id @default(cuid())
  groupId      String
  authorId     String
  content      String
  images       String[]
  likeCount    Int      @default(0)
  commentCount Int      @default(0)
  createdAt    DateTime @default(now())

  group    Group              @relation(fields: [groupId], references: [id], onDelete: Cascade)
  author   User               @relation(fields: [authorId], references: [id], onDelete: Cascade)
  likes    GroupPostLike[]
  comments GroupPostComment[]

  @@index([groupId])
  @@map("group_posts")
}

model GroupPostLike {
  id          String   @id @default(cuid())
  groupPostId String
  userId      String
  createdAt   DateTime @default(now())

  groupPost GroupPost @relation(fields: [groupPostId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupPostId, userId])
  @@index([groupPostId])
  @@map("group_post_likes")
}

model GroupPostComment {
  id          String   @id @default(cuid())
  groupPostId String
  userId      String
  content     String
  createdAt   DateTime @default(now())

  groupPost GroupPost @relation(fields: [groupPostId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([groupPostId])
  @@map("group_post_comments")
}

// =========================================================================
// SUPPORT TICKETS (Help & Support "contact us" submissions)
// =========================================================================

model SupportTicket {
  id        String              @id @default(cuid())
  userId    String
  category  String
  subject   String
  message   String
  status    SupportTicketStatus @default(OPEN)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  chatbotConversation ChatbotConversation?

  @@index([userId])
  @@map("support_tickets")
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

// =========================================================================
// CHATBOT (real AI-assisted support chat for Customer/Provider/Shopkeeper.
// Deliberately separate from Conversation/Message — those are strictly
// User-to-User with no bot-sender concept, so overloading them would need a
// fake "bot User" row. Escalating creates a genuine SupportTicket, reviewed
// by Admin/Sub-Admin/Agent — same reviewer set as Shop Upgrade Requests.)
// =========================================================================

model ChatbotConversation {
  id                String                    @id @default(cuid())
  userId            String
  status            ChatbotConversationStatus @default(ACTIVE)
  escalatedTicketId String?                   @unique
  // Whichever Admin/Sub-Admin/Agent "accepts" the escalation — once set,
  // only this reviewer can send STAFF replies (first-claim-wins, same as a
  // real support queue), everyone else can still see the transcript.
  assignedStaffId   String?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  ticket       SupportTicket?   @relation(fields: [escalatedTicketId], references: [id])
  assignedStaff User?           @relation("ChatbotAssignedStaff", fields: [assignedStaffId], references: [id])
  messages     ChatbotMessage[]

  @@index([userId])
  @@map("chatbot_conversations")
}

enum ChatbotConversationStatus {
  ACTIVE
  ESCALATED
  CLOSED
}

model ChatbotMessage {
  id             String             @id @default(cuid())
  conversationId String
  role           ChatbotMessageRole
  content        String
  isRead         Boolean            @default(false)
  // Only set for STAFF-role messages — which real reviewer sent this reply.
  senderId       String?
  createdAt      DateTime           @default(now())

  conversation ChatbotConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User?               @relation("ChatbotStaffSender", fields: [senderId], references: [id])

  @@index([conversationId])
  @@map("chatbot_messages")
}

enum ChatbotMessageRole {
  USER
  ASSISTANT
  STAFF
}

// =========================================================================
// RECENTLY VIEWED (customer home page — a real, per-user view history;
// title/subtitle/image are a denormalized snapshot taken at view time, same
// pattern as ContentReport.contentSnapshot, so a later rename/delete of the
// underlying Service/Product doesn't retroactively corrupt what the customer
// actually saw)
// =========================================================================

model RecentlyViewed {
  id         String             @id @default(cuid())
  userId     String
  targetType RecentlyViewedType
  targetId   String
  title      String
  subtitle   String?
  image      String?
  href       String
  viewedAt   DateTime           @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetType, targetId])
  @@index([userId, viewedAt])
  @@map("recently_viewed")
}

// =========================================================================
// WEB PUSH — real browser push subscriptions (Web Push API + VAPID). One
// row per subscribed browser/device; a user can have several (phone,
// laptop, etc). Unlike the payment gateways, this needs no third-party
// account — just a self-generated VAPID keypair (see .env.example).
// =========================================================================

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

enum RecentlyViewedType {
  SERVICE
  PRODUCT
}

// =========================================================================
// LIVE STREAMING (real WebRTC sessions via LiveKit — providers and
// shopkeepers broadcast, customers watch. Exactly one of providerId /
// shopkeeperId is set per session, mirroring how Dispute optionally links
// to either side rather than a generic polymorphic host field — keeps the
// relation to ProviderProfile/ShopkeeperProfile direct and joinable.)
// =========================================================================

model LiveSession {
  id           String            @id @default(cuid())
  providerId   String?
  shopkeeperId String?
  roomName     String            @unique
  title        String
  description  String?
  category     String?
  status       LiveSessionStatus @default(LIVE)
  startedAt    DateTime          @default(now())
  endedAt      DateTime?
  peakViewers  Int               @default(0)
  likeCount    Int               @default(0)
  createdAt    DateTime          @default(now())

  provider   ProviderProfile?      @relation(fields: [providerId], references: [id], onDelete: Cascade)
  shopkeeper ShopkeeperProfile?    @relation(fields: [shopkeeperId], references: [id], onDelete: Cascade)
  messages   LiveChatMessage[]
  products   LiveSessionProduct[]
  gifts      LiveGift[]

  @@index([providerId])
  @@index([shopkeeperId])
  @@index([status])
  @@map("live_sessions")
}

model LiveChatMessage {
  id            String   @id @default(cuid())
  liveSessionId String
  senderId      String
  message       String
  createdAt     DateTime @default(now())

  liveSession LiveSession @relation(fields: [liveSessionId], references: [id], onDelete: Cascade)
  sender      User        @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([liveSessionId])
  @@map("live_chat_messages")
}

// A shopkeeper's chosen showcase list for one live session — customers see
// these with real price/stock and can add-to-cart without leaving the
// stream. Providers don't use this (their sessions never get rows here).
model LiveSessionProduct {
  id            String   @id @default(cuid())
  liveSessionId String
  productId     String
  addedAt       DateTime @default(now())

  liveSession LiveSession @relation(fields: [liveSessionId], references: [id], onDelete: Cascade)
  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([liveSessionId, productId])
  @@index([liveSessionId])
  @@map("live_session_products")
}

// Coin economy: customers buy Coins with real KES from their existing
// Wallet (COIN_TO_KES rate lives in code, not schema — see live-gifts.ts),
// then spend Coins sending Gifts during a live session. Each Gift sent
// credits the host's real Wallet 1:1 with the coin's KES-equivalent value —
// same real ledger (Transaction) every other payout in this app already
// uses, not a separate fake economy.
model Gift {
  id        String   @id @default(cuid())
  name      String
  emoji     String
  coinCost  Int
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)

  liveGifts LiveGift[]

  @@map("gifts")
}

model LiveGift {
  id            String   @id @default(cuid())
  liveSessionId String
  senderId      String
  giftId        String
  quantity      Int      @default(1)
  coinCost      Int
  createdAt     DateTime @default(now())

  liveSession LiveSession @relation(fields: [liveSessionId], references: [id], onDelete: Cascade)
  sender      User        @relation("LiveGiftSender", fields: [senderId], references: [id], onDelete: Cascade)
  gift        Gift        @relation(fields: [giftId], references: [id])

  @@index([liveSessionId])
  @@index([senderId])
  @@map("live_gifts")
}

model CoinTransaction {
  id          String              @id @default(cuid())
  userId      String
  type        CoinTransactionType
  amount      Int
  description String
  createdAt   DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("coin_transactions")
}

enum CoinTransactionType {
  PURCHASE
  GIFT_SENT
}

enum LiveSessionStatus {
  LIVE
  ENDED
}
