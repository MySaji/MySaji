# Enter these in the staging Compose Environment UI; never commit real values.
APP_IMAGE=saji:staging-REPLACE_COMMIT
SITE_URL=https://staging.mysaji.com
DATABASE_URL=postgresql://saji_app:REPLACE_URL_ENCODED@db:5432/saji?schema=public
AUTH_SECRET=REPLACE_STAGING_ONLY
CRON_SECRET=REPLACE_STAGING_ONLY
PAYMENT_METHOD_ENCRYPTION_KEY=REPLACE_STAGING_32_BYTE_BASE64
SAJI_SECRETS_DIR=/etc/saji/staging/secrets
DB_IMAGE=postgis/postgis:17-3.5@sha256:01a6a70e41e6c4467c8f55f6063555ed72db2d6662cd0d571040d42eadaeb6f6
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
NEXT_PUBLIC_SENTRY_DSN=
SAJI_CONFIG_DIR=/etc/saji/staging
