# Copy to ops/app.env, chmod 600; use URL-encoded independent passwords.
DATABASE_URL=postgresql://saji_app:REPLACE_URL_ENCODED@db:5432/saji?schema=public
DIRECT_URL=postgresql://saji_app:REPLACE_URL_ENCODED@db:5432/saji?schema=public
AUTH_SECRET=REPLACE_WITH_RANDOM_SECRET
AUTH_TRUST_HOST=true
AUTH_URL=https://mysaji.com
NEXTAUTH_URL=https://mysaji.com
NEXT_PUBLIC_SITE_URL=https://mysaji.com
CALLBACK_URL=https://mysaji.com
CRON_SECRET=REPLACE_WITH_RANDOM_SECRET
PAYMENT_METHOD_ENCRYPTION_KEY=REPLACE_WITH_PRESERVED_32_BYTE_BASE64_KEY
MPESA_ENV=sandbox
MPESA_ENVIRONMENT=sandbox
PAYPAL_ENVIRONMENT=sandbox
# Intentionally no real payment, SMTP, SMS, AI or customer credentials.
# Public NEXT_PUBLIC_* values must also be passed during image build.
