// SAJI Platform — Database Schema
// Reconciles ~15+ duplicate/conflicting mock-data shapes found across the frontend
// (see conversation history for the per-portal inventory this was derived from)
// into one canonical, normalized model per entity.
//
// Stack: PostgreSQL (hosted on Supabase) + Prisma ORM + Auth.js (NextAuth v5)

generator client {
  provider      = "prisma-client-js"
  // "native" covers whatever OS runs `prisma generate` (this dev machine is
  // Windows) — the rest are the common Linux shared-hosting variants, so the
  // query engine that ships to HostPinnacle actually runs there. Confirm the
  // exact OS/OpenSSL version with HostPinnacle support and trim this list
  // once known; shipping a few extra binaries costs generate time/disk, not
  // correctness.
  binaryTargets = ["native", "debian-openssl-3.0.x", "debian-openssl-1.1.x", "rhel-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// =========================================================================
// ENUMS
// =========================================================================

enum Role {
  CUSTOMER
  PROVIDER
  SHOPKEEPER
  DISTRIBUTOR
  AGENT
  SECRETARY
  SUB_ADMIN
  ADMIN
}

enum KycStatus {
  PENDING
  APPROVED
  REJECTED
}

/// The capability tier an account has earned — what it is *allowed to do*,
/// as opposed to `KycStatus`, which is the review verdict on whatever
/// documents it last submitted. The two are deliberately separate:
///
///   BASIC             signed up, never submitted documents. Can browse,
///                     search, save favourites, build drafts — but cannot
///                     move money, transact, or publish.
///   PENDING           documents submitted, awaiting review. Same
///                     restrictions as BASIC; the difference is only what
///                     the UI tells them to do next.
///   VERIFIED          reviewed and approved. Full transactional access.
///   PREMIUM_VERIFIED  reserved for a future enhanced tier (see
///                     lib/verification-gate.ts) — nothing requires it yet,
///                     and it satisfies every VERIFIED requirement.
///
/// A rejection is *not* a state here: it sends the account back to BASIC
/// while `kycStatus` holds REJECTED, so the gate treats them like anyone
/// unverified while the UI can still explain why and invite a resubmission.
enum VerificationStatus {
  BASIC
  PENDING
  VERIFIED
  PREMIUM_VERIFIED
}

enum ServiceApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

