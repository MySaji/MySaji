// =========================================================================
// MESSAGING
// Reconciles: per-portal chat mocks that either discarded messages
// (secretary/messages), mutated a module-level object instead of React
// state (admin/messages), or weren't keyed by conversation at all
// (shopkeeper/messages) — one real Conversation/Message model for everyone.
// =========================================================================

model Conversation {
  id             String    @id @default(cuid())
  participantAId String
  participantBId String
  jobId          String?   @unique
  lastMessageAt  DateTime?
  isArchived     Boolean   @default(false)
  createdAt      DateTime  @default(now())

  participantA User         @relation("ConversationParticipantA", fields: [participantAId], references: [id])
  participantB User         @relation("ConversationParticipantB", fields: [participantBId], references: [id])
  job          Job?         @relation(fields: [jobId], references: [id])
  messages     Message[]
  callSignals  CallSignal[]
  callLogs     CallLog[]

  @@unique([participantAId, participantBId, jobId])
  @@index([participantAId])
  @@index([participantBId])
  @@map("conversations")
}

model Message {
  id              String      @id @default(cuid())
  conversationId  String
  senderId        String
  type            MessageType @default(TEXT)
  content         String?
  attachmentUrl   String?
  isRead          Boolean     @default(false)
  readAt          DateTime?
  relatedStatusId String?
  /// The message this one is a reply to — set by swiping a bubble to reply.
  /// SetNull rather than Cascade so deleting the quoted message leaves the
  /// reply standing (it just stops showing a quote) instead of silently
  /// destroying an unrelated part of the conversation.
  replyToId       String?
  createdAt       DateTime    @default(now())

  conversation  Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender        User            @relation("MessageSender", fields: [senderId], references: [id])
  relatedStatus ProviderStatus? @relation("MessageRelatedStatus", fields: [relatedStatusId], references: [id], onDelete: SetNull)
  replyTo       Message?        @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies       Message[]       @relation("MessageReplies")

  @@index([conversationId])
  @@index([senderId])
  @@map("messages")
}

// Ephemeral WebRTC signaling rows (SDP offers/answers, ICE candidates, ring/
// hangup/reject events) for real-time voice calls between two conversation
// participants. Polled (short interval) rather than pushed since this app
// has no persistent WebSocket server — same reasoning as the 5s message
// poll, just faster because call setup is latency-sensitive. Rows are
// short-lived: cleared once a call ends (see clearCallSignals).
/// How a call ended. Recorded once per call, by the caller — they are the
/// one side that knows both when it started and how it finished, so logging
/// from both ends would double-count every call.
enum CallOutcome {
  COMPLETED
  MISSED
  DECLINED
}

/// A finished voice call, for the Calls tab in Messages.
///
/// Separate from CallSignal, which is transient WebRTC plumbing deleted
/// within seconds of a call. This is the durable record: who called whom,
/// when, and for how long.
model CallLog {
  id              String      @id @default(cuid())
  conversationId  String
  callerId        String
  calleeId        String
  outcome         CallOutcome
  /// Seconds of connected audio — zero for a call that was never answered.
  durationSeconds Int         @default(0)
  /// When the callee picked up. Used to derive durationSeconds on hangup
  /// rather than trusting a number from the client, which is lost whenever
  /// the hangup signal is.
  answeredAt      DateTime?
  createdAt       DateTime    @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  caller       User         @relation("CallLogCaller", fields: [callerId], references: [id], onDelete: Cascade)
  callee       User         @relation("CallLogCallee", fields: [calleeId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([callerId])
  @@index([calleeId])
  @@map("call_logs")
}

model CallSignal {
  id             String   @id @default(cuid())
  conversationId String
  fromUserId     String
  toUserId       String
  type           String
  payload        Json
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([toUserId])
  @@map("call_signals")
}

