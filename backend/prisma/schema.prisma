// ---------------------------------------------------------------------------
// Saji Pro business types
//
// One Saji Pro account can legitimately do several things at once — fix taps,
// sell the parts, rent out the tools, and teach an evening class. `User.role`
// is a single scalar baked into the session JWT and read by every route guard,
// so it stays exactly as it is (PROVIDER for a Saji Pro account). What that
// account actually *does* is described here instead, as a set of rows, the
// same optional-capability pattern DriverProfile already uses.
//
// Nothing reads these to decide access — verification and role guards are
// untouched. They decide which modules the portal *shows*, which is a
// presentation concern, resolved against the admin-controlled matrix below.
// ---------------------------------------------------------------------------

enum ProBusinessType {
  SERVICES // Offer services — the classic provider
  PRODUCTS // Sell products — the merchant half, backed by ShopkeeperProfile
  RENTALS // Rent out items
  FREELANCE // Freelance online
  TUTORING // Teach & tutor
  CONSULTING // Consulting
  POS // Run a till — backed by ShopkeeperProfile as the tenant, but
  // not necessarily listed on SAJI. The one value here that is
  // exclusive rather than additive: see isAllowedCombination in
  // lib/pro-modules.ts.
}

enum ProCapabilityStatus {
  /// Chosen at signup, or approved by staff afterwards. The module is live.
  ACTIVE
  /// Requested from inside the portal, waiting on admin/sub-admin/agent.
  PENDING
  REJECTED
}

model ProCapability {
  id           String              @id @default(cuid())
  userId       String
  type         ProBusinessType
  status       ProCapabilityStatus @default(ACTIVE)
  /// What the account said when asking for this to be added.
  note         String?
  /// Why staff approved or turned it down.
  reviewNote   String?
  requestedAt  DateTime            @default(now())
  reviewedAt   DateTime?
  reviewedById String?

  user       User  @relation("ProCapabilityOwner", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("ProCapabilityReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([userId, type])
  @@index([status])
  @@index([userId])
  @@map("pro_capabilities")
}

/// Admin's override of lib/pro-modules.ts's defaults: which portal pages a
/// given business type unlocks. A row only ever exists for a deliberate admin
/// decision — absent means "use the default in code", so the matrix starts
/// empty and the portal behaves exactly as the code says until someone
/// changes something.
model ProModuleSetting {
  id           String          @id @default(cuid())
  businessType ProBusinessType
  moduleKey    String
  enabled      Boolean         @default(true)
  updatedAt    DateTime        @updatedAt
  updatedById  String?

  updatedBy User? @relation("ProModuleSettingEditor", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([businessType, moduleKey])
  @@index([businessType])
  @@map("pro_module_settings")
}

// ===========================================================================
// POINT OF SALE
// ===========================================================================
//
// Four ideas hold this together. They are worth stating before the models,
// because each one is a decision that could reasonably have gone the other
// way:
//
// 1. THE TENANT IS ShopkeeperProfile. No new `businesses` table. SAJI already
//    has exactly one row per shop, already owns the catalogue, already carries
//    the location and the trading hours. A second tenant table would mean two
//    answers to "which shop is this", and the till would eventually disagree
//    with the storefront.
//
// 2. EVERY POS TABLE CARRIES shopkeeperId DIRECTLY, even where it could be
//    reached through a parent. Tenant isolation then needs no joins: every
//    query filters on one indexed column, and a missing filter is visible by
//    reading the query rather than by tracing a relation. Denormalisation
//    bought deliberately.
//
// 3. STOCK IS A LEDGER, NOT A NUMBER. StockMovement is append-only. A
//    correction is a new row with the opposite sign, never an edit, because a
//    stock figure nobody can explain is a stock figure nobody trusts — and
//    "who took the twelve crates" is the single question a shopkeeper most
//    wants a POS to answer. Inventory.stockOnHand is a PROJECTION of this
//    ledger, kept for speed; the ledger is the truth.
//
// 4. A COUNTER SALE IS NOT AN Order.
//
//    POS2.md proposed reusing Order with a channel flag, and that was wrong.
//    Order requires a customerId that FKs to a real User account; a walk-in
//    has none. Order carries an address, a delivery fee, an escrow-backed
//    Payment and a PENDING -> SHIPPED -> DELIVERED lifecycle; a counter sale
//    is complete the moment the cash is in the drawer. Worse, every existing
//    revenue, "orders today" and shop-analytics query counts Order rows
//    unfiltered — overloading the table would silently fold counter takings
//    into figures that have always meant marketplace orders.
//
//    So PosSale is its own table. The two channels meet where they should:
//    at the shared Product catalogue and the shared StockMovement ledger.
//    One stock figure, two ways to sell from it, and no ambiguity about
//    which kind of sale a row is.

enum StockMovementKind {
  OPENING_BALANCE // the figure the shop started with when POS was switched on
  PURCHASE // received from a supplier or a wholesale order
  SALE // sold at the till
  SALE_REVERSAL // a voided or refunded till sale putting stock back
  ORDER_FULFILMENT // shipped against a marketplace Order
  ORDER_RESTOCK // a cancelled or returned marketplace Order
  RETURN // a customer brought it back over the counter
  COUNT_ADJUSTMENT // a physical count disagreed with the ledger
  WASTAGE // spoiled, broken, expired or stolen
  TRANSFER_IN
  TRANSFER_OUT
  BULK_BREAK_IN // the pieces a broken bale produced
  BULK_BREAK_OUT // the bale that was broken
}

/// One immutable fact about stock moving. Never updated, never deleted.
model StockMovement {
  id           String            @id @default(cuid())
  shopkeeperId String
  productId    String
  /// Which variant moved, where the product has them. Null for a product
  /// that sells as itself, which is most of them. The balance for a variant
  /// product is therefore per (productId, variantId), and the product-level
  /// figure is the sum across its variants.
  variantId    String?
  /// Which delivery moved. Null for a product whose stock is not batched.
  /// The balance for a batched product is per (product, variant, batch),
  /// and the figures above it are sums.
  batchId      String?
  kind         StockMovementKind
  /// SIGNED. Positive is stock arriving, negative is stock leaving. Signing
  /// the quantity rather than pairing a magnitude with a direction flag means
  /// the balance is a plain SUM() and cannot be got wrong by forgetting to
  /// branch on the kind.
  quantity     Decimal           @db.Decimal(14, 3)
  /// The unit this movement was measured in, snapshotted. A product's unit
  /// can be changed later and that must not retroactively reinterpret
  /// history: 40 recorded as bags stays 40 bags.
  unit         String            @default("piece")
  /// Cost per unit at the time, for valuing stock on hand and costing loss.
  unitCost     Decimal?          @db.Decimal(12, 2)
  /// The projected balance immediately after this movement. Strictly
  /// redundant — it is the running SUM — and kept anyway so a shopkeeper
  /// reading a stock history sees the figure the till showed them at the
  /// time, and so a divergence between ledger and projection is detectable
  /// rather than merely suspected.
  balanceAfter Decimal?          @db.Decimal(14, 3)
  reason       String?

  /// What caused this. At most one of these is set.
  posSaleId        String?
  orderId          String?
  wholesaleOrderId String?
  /// Who recorded it. A plain column, not a relation: adding a back-relation
  /// to User for each of these would mean more fields on a model that already
  /// carries dozens, for no query anyone needs.
  actorUserId      String?

  /// Offline-first, and the reason stock cannot be double-counted.
  ///
  /// A till that lost its connection queues movements locally and replays
  /// them. A replay must be a no-op, not a second deduction, so the device
  /// generates this key once and the unique constraint below makes the
  /// second insert fail rather than succeed quietly. Nullable: a movement
  /// recorded on the server has no device and needs no key.
  idempotencyKey String?
  deviceId       String?

  /// When it happened at the counter, which on an offline till is not when
  /// the server heard about it. Reports must use occurredAt; sync debugging
  /// needs createdAt. Keeping both is the whole point.
  occurredAt DateTime
  createdAt  DateTime @default(now())

  shopkeeper ShopkeeperProfile @relation(fields: [shopkeeperId], references: [id], onDelete: Cascade)
  product    Product           @relation(fields: [productId], references: [id])
  variant    ProductVariant?   @relation(fields: [variantId], references: [id])
  batch      ProductBatch?     @relation(fields: [batchId], references: [id])

  @@unique([shopkeeperId, idempotencyKey])
  @@index([shopkeeperId, batchId, occurredAt])
  @@index([shopkeeperId, variantId, occurredAt])
  @@index([shopkeeperId, productId, occurredAt])
  @@index([shopkeeperId, occurredAt])
  @@index([shopkeeperId, kind, occurredAt])
  @@index([posSaleId])
  @@map("stock_movements")
}

enum PosSaleStatus {
  COMPLETED
  PARKED // rung up and set aside, not yet paid
  VOIDED // cancelled before the drawer closed
  /// Every line came back. The sale happened and was undone.
  REFUNDED
  /// Some lines came back, the rest stayed sold. Distinct from REFUNDED
  /// because a shop asking "what did we actually sell" must not be told
  /// either "all of it" or "none of it" when the answer is "two of three".
  PART_REFUNDED
  /// Part-paid and waiting on delivery or collection.
  ///
  /// A separate status from PARKED on purpose: a parked sale is one nobody
  /// has paid for and that can simply be dropped, while this one has the
  /// customer's money in the drawer and goods owed against it. Reports count
  /// the DEPOSIT TAKEN on these, never the full price, because the rest has
  /// not been earned yet.
  DEPOSIT
}

enum PosPaymentMethod {
  CASH
  MPESA
  CARD
  BANK
  CREDIT // on the shop's own book, to be settled later
  SPLIT // several of the above; see PosPayment rows
}

/// A sale across the counter.
model PosSale {
  id            String  @id @default(cuid())
  shopkeeperId  String
  /// Human-readable and sequential WITHIN A SHOP. Two shops both having a
  /// sale 0001 is correct and expected; Order.orderNumber is globally unique
  /// because a customer quotes it to support, whereas a receipt number is
  /// quoted to the shop that issued it.
  saleNumber    String
  tillSessionId String?
  /// Who served. Plain columns, as on StockMovement.
  cashierUserId String?
  cashierName   String?

  subtotal    Decimal @db.Decimal(14, 2)
  discount    Decimal @default(0) @db.Decimal(14, 2)
  tax         Decimal @default(0) @db.Decimal(14, 2)
  total       Decimal @db.Decimal(14, 2)
  /// What was handed over, and what went back. Cash reconciliation is the
  /// first thing a shopkeeper checks and the last thing they forgive.
  amountPaid  Decimal @default(0) @db.Decimal(14, 2)
  changeGiven Decimal @default(0) @db.Decimal(14, 2)

  status        PosSaleStatus    @default(COMPLETED)
  paymentMethod PosPaymentMethod @default(CASH)

  /// A walk-in has no account. Name and phone are free text precisely so a
  /// sale never requires one to exist; customerId is set only when the buyer
  /// happens to be a SAJI customer, and is a plain column for the same
  /// reason as the others.
  customerName  String?
  customerPhone String?
  customerId    String?
  /// Set when the cashier confirmed the buyer's age for a restricted line.
  ///
  /// Recorded rather than merely enforced: for a liquor licence the useful
  /// artefact is a record that the check happened on that sale, at that
  /// time, by that cashier — not a dialog nobody can prove appeared.
  ageVerified   Boolean @default(false)

  /// Same contract as StockMovement.idempotencyKey: generated by the device,
  /// unique per shop, so replaying a queued sale cannot ring it up twice.
  idempotencyKey String?
  deviceId       String?

  occurredAt DateTime
  createdAt  DateTime  @default(now())
  /// When the server accepted it. Null while a sale exists only on a till.
  syncedAt   DateTime?

  /// What is still owed on a DEPOSIT sale. Zero on every other kind.
  balanceDue  Decimal   @default(0) @db.Decimal(14, 2)
  /// When the customer expects it. Shown on the receipt, which is the only
  /// thing most customers keep.
  dueDate     DateTime?
  /// When it was actually handed over, which closes the sale.
  fulfilledAt DateTime?

  voidedAt       DateTime?
  voidReason     String?
  voidedByUserId String?

  shopkeeper  ShopkeeperProfile @relation(fields: [shopkeeperId], references: [id], onDelete: Cascade)
  tillSession TillSession?      @relation(fields: [tillSessionId], references: [id])

  items    PosSaleItem[]
  payments PosPayment[]
  returns  PosReturn[]

  @@unique([shopkeeperId, saleNumber])
  @@unique([shopkeeperId, idempotencyKey])
  @@index([shopkeeperId, occurredAt])
  @@index([shopkeeperId, status, occurredAt])
  @@index([tillSessionId])
  @@map("pos_sales")
}

model PosSaleItem {
  id           String    @id @default(cuid())
  saleId       String
  /// Nullable, and the name below is snapshotted, because a receipt must
  /// stay readable after a product is deleted or renamed. An OrderItem can
  /// rely on its Product surviving; a till receipt from two years ago cannot.
  productId    String?
  /// Nullable for the same reason productId is: a receipt must stay
  /// readable after the variant is gone, so the label below is snapshotted.
  variantId    String?
  variantLabel String?
  /// Which delivery this line came out of, where the whole line came from
  /// one. Null when a line was filled from SEVERAL batches — the stock
  /// movements carry the per-batch detail in that case, and they are what a
  /// recall is traced through, so nothing is lost by this being null.
  batchId      String?
  /// Snapshotted beside the id, like the name and the size: a recall is
  /// often run long after a batch row has been tidied away.
  batchNumber  String?
  batchExpiry  DateTime?
  name         String
  sku          String?
  barcode      String?

  /// Fractional, which is one reason this is not an OrderItem:
  /// OrderItem.quantity is an Int and widening it would change the type that
  /// two hundred-odd marketplace call sites already depend on.
  quantity Decimal @db.Decimal(14, 3)
  unit     String  @default("piece")

  unitPrice       Decimal  @db.Decimal(12, 2)
  lineDiscount    Decimal  @default(0) @db.Decimal(12, 2)
  totalPrice      Decimal  @db.Decimal(14, 2)
  /// Cost at the moment of sale, so margin is historical fact rather than
  /// today's cost price applied to last year's sales.
  costAtSale      Decimal? @db.Decimal(12, 2)
  /// True when the cashier typed the price rather than taking the product's
  /// (the OPEN_PRICE trait). Worth recording: it is the line a shopkeeper
  /// reviewing a suspicious day looks for first.
  priceOverridden Boolean  @default(false)
  /// The serials that went out on this line, snapshotted as text.
  ///
  /// Denormalised beside the ProductSerial rows on purpose: a receipt and a
  /// warranty claim both need to read "which IMEI did I sell this customer"
  /// long after the register row may have been tidied, and a line can carry
  /// several where the quantity was more than one.
  serials         String[]
  notes           String?

  sale        PosSale         @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product     Product?        @relation(fields: [productId], references: [id])
  variant     ProductVariant? @relation(fields: [variantId], references: [id])
  batch       ProductBatch?   @relation(fields: [batchId], references: [id])
  returnItems PosReturnItem[]

  @@index([saleId])
  @@index([batchId])
  @@index([productId])
  @@map("pos_sale_items")
}

/// One tender against one sale. Only needed for SPLIT payments, but every
/// sale gets rows so a day's takings can be summed by method from one table.
model PosPayment {
  id        String           @id @default(cuid())
  saleId    String
  method    PosPaymentMethod
  amount    Decimal          @db.Decimal(14, 2)
  /// An M-Pesa code, a card reference, or whatever the shopkeeper wrote down.
  reference String?
  createdAt DateTime         @default(now())

  /// Set only when the till sent an STK prompt for this payment.
  ///
  /// `stkConfirmed` carries the distinction this app keeps making elsewhere:
  /// a code a cashier typed in is RECORDED, while one Daraja returned
  /// against a prompt we sent is CONFIRMED. The receipt is allowed to say
  /// which, and the cashier is never told we checked when we did not.
  stkCheckoutId String?
  stkConfirmed  Boolean @default(false)
  stkPhone      String?

  sale PosSale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@map("pos_payments")
}

/// A cashier's shift: the drawer opening, the drawer closing, and whether the
/// cash in it matched what the till expected.
model TillSession {
  id            String  @id @default(cuid())
  shopkeeperId  String
  cashierUserId String?
  cashierName   String?
  deviceId      String?

  openedAt     DateTime  @default(now())
  closedAt     DateTime?
  /// Cash in the drawer at the start.
  openingFloat Decimal   @default(0) @db.Decimal(14, 2)
  /// What the shift's sales say should be in the drawer. Computed and stored
  /// at close rather than recomputed on read, so a later void or correction
  /// cannot retroactively change what a closed shift reported.
  expectedCash Decimal?  @db.Decimal(14, 2)
  /// What was actually counted.
  countedCash  Decimal?  @db.Decimal(14, 2)
  /// countedCash - expectedCash. Stored for the same reason: a variance is a
  /// fact about a moment, and recomputing it later would quietly rewrite it.
  variance     Decimal?  @db.Decimal(14, 2)
  note         String?

  shopkeeper ShopkeeperProfile @relation(fields: [shopkeeperId], references: [id], onDelete: Cascade)
  sales      PosSale[]

  @@index([shopkeeperId, openedAt])
  @@index([shopkeeperId, closedAt])
  @@map("till_sessions")
}

/// A machine authorised to run this shop's till.
///
/// Exists so a stolen counter laptop can be revoked without changing the
/// shopkeeper's password, and so an offline sale can be attributed to the
/// device that took it.
/// What a person may do in a POS business.
///
/// Five, because the document this was built against names five and each one
/// is a real job in a Kenyan supermarket. They are NOT a hierarchy with a
/// number attached: an accountant outranks nobody but sees the money, and a
/// stock controller touches goods but must not be near the drawer. A single
/// "level" field would force those two into an order that does not exist.
enum PosStaffRole {
  /// The account holder. Everything, including billing and deleting the business.
  OWNER
  /// Runs the shop day to day. Everything except business-level settings.
  MANAGER
  /// The till, and looking up stock to answer a customer. Nothing else.
  CASHIER
  /// Goods in and goods counted. Deliberately no access to takings.
  STOCK_CONTROLLER
  /// The money, read mostly. No till, because approving your own figures is
  /// the oldest problem in bookkeeping.
  ACCOUNTANT
}

/// A POS account, which is not a SAJI Pro portal.
///
/// WHY THIS EXISTS SEPARATELY FROM ShopkeeperProfile
///
/// A till was first built as one of the Saji Pro business types, which meant
/// a shopkeeper got a marketplace portal they never asked for and a POS that
/// borrowed its identity from it. A supermarket is its own product with its
/// own staff, its own login and its own idea of who may do what, and this is
/// the row that owns all of that.
///
/// A ShopkeeperProfile is still where a store's catalogue, stock and sales
/// live, which is why every POS table keeps pointing at it. This sits ABOVE
/// that: one business, its people, its settings, and in time its branches.
model PosBusiness {
  id          String @id @default(cuid())
  ownerUserId String @unique

  name     String
  /// ISO country. Kenya unless someone deliberately changes it.
  country  String @default("KE")
  currency String @default("KES")
  timezone String @default("Africa/Nairobi")

  /// Collected when the business has them. Optional during onboarding on
  /// purpose: a duka that has not registered yet still needs to sell today.
  registrationNumber String?
  taxPin             String?

  /// Street address, kept as fields rather than one blob so a receipt and a
  /// delivery note can be laid out properly.
  county     String?
  town       String?
  street     String?
  postalCode String?

  /// Which preset built this business, and which VERSION of it. The version
  /// matters: a profile gains modules over time, and a business configured
  /// under version 1 must not silently acquire them.
  profileKey     String @default("SUPERMARKET")
  profileVersion Int    @default(1)

  /// How far through the setup wizard they got, so leaving and coming back
  /// does not start again. Null once setup is finished.
  onboardingStep   String?
  /// What they have entered so far, by step. Shape lives with the wizard.
  onboardingData   Json?
  setupCompletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner  User       @relation("PosBusinessOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  stores PosStore[]
  staff  PosStaff[]

  @@map("pos_businesses")
}

/// One shop floor.
///
/// Wraps the ShopkeeperProfile that actually holds the catalogue and stock,
/// so every existing POS table keeps working unchanged while a business
/// gains the ability to have more than one of them.
model PosStore {
  id           String   @id @default(cuid())
  businessId   String
  /// The shop whose catalogue, stock and sales this store is.
  shopkeeperId String   @unique
  name         String
  /// Shown on this store's receipts where it differs from the business name.
  branchLabel  String?
  phone        String?
  county       String?
  town         String?
  street       String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  business   PosBusiness       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  shopkeeper ShopkeeperProfile @relation(fields: [shopkeeperId], references: [id], onDelete: Cascade)
  staff      PosStaff[]

  @@index([businessId])
  @@map("pos_stores")
}

/// A person who works in the business.
///
/// Deliberately NOT a User in the ordinary case. A shop assistant should be
/// able to ring up a sale without a SAJI account, an email address or a
/// password they will forget, and the owner should be able to revoke them
/// the same afternoon they leave. `userId` links the row to a real account
/// only where that person genuinely has one, which is the owner and, if the
/// owner chooses, a manager who needs to sign in from home.
///
/// Supersedes PosCashier, which only knew about two roles and one shop.
model PosStaff {
  id         String  @id @default(cuid())
  businessId String
  /// Null means every store in the business. Set for staff tied to one shop.
  storeId    String?
  userId     String?

  name    String
  role    PosStaffRole @default(CASHIER)
  /// Four to six digits, bcrypt hashed. Identifies who is at the counter; it
  /// is not a password and is not treated as one.
  pinHash String?
  /// Set where this person can also sign in properly, away from the till.
  email   String?
  phone   String?

  isActive   Boolean   @default(true)
  lastSeenAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  business PosBusiness @relation(fields: [businessId], references: [id], onDelete: Cascade)
  store    PosStore?   @relation(fields: [storeId], references: [id], onDelete: SetNull)
  user     User?       @relation("PosStaffUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([storeId])
  @@index([userId])
  @@map("pos_staff")
}

/// Something a person did that someone may later need to account for.
///
/// The stock ledger already makes every movement of goods auditable. This is
/// for everything else: a void, a price override, a permission change, a
/// device revoked, a setting altered. Those leave no trace in stock and are
/// exactly what gets asked about when money is missing.
///
/// Append only. There is no update path and no delete path, by design.
model PosAuditEvent {
  id           String   @id @default(cuid())
  businessId   String
  storeId      String?
  /// The SAJI account that acted, where there was one.
  actorUserId  String?
  /// The staff member that acted, where the action came from the till.
  actorStaffId String?
  /// Free text, because the person reading this is a shopkeeper, not a
  /// developer: "Wanjiku voided sale S-0042".
  summary      String
  /// A stable machine key for filtering: "sale.void", "staff.role_changed".
  action       String
  entityType   String?
  entityId     String?
  /// Whatever the action needs to be understood later.
  detail       Json?
  createdAt    DateTime @default(now())

  @@index([businessId, createdAt])
  @@index([businessId, action])
  @@map("pos_audit_events")
}

/// Goods brought back over the counter.
///
/// WHY THIS IS NOT A VOID
///
/// A void says the sale should never have happened: it is a correction made
/// in the same breath, before the drawer closed. A return says the sale was
/// real, the customer took the goods home, and some or all of them came
/// back. Collapsing the two loses the one fact a shopkeeper most wants from
/// this table, which is how much of what they sell comes back and why.
///
/// WHY IT POINTS AT THE ORIGINAL SALE
///
/// Because the alternative is a shop paying out on goods it never sold. The
/// original line caps what may come back and fixes the price it is refunded
/// at, so a customer cannot return four of a thing they bought three of, or
/// return at today's price something bought on offer last week.
model PosReturn {
  id           String @id @default(cuid())
  shopkeeperId String
  /// The sale this came back from. Required: a return with no original is
  /// not a return, it is a payout.
  saleId       String
  returnNumber String

  /// What the customer gets back, which is the sum of the lines less any
  /// restocking the shop chose not to refund.
  totalRefunded Decimal          @db.Decimal(14, 2)
  method        PosPaymentMethod
  reason        String
  /// Free text from the counter: "wrong size", "expired", "changed mind".
  note          String?

  /// Who handled it, and under whose approval.
  handledByUserId String?
  handledByName   String?
  approvedByName  String?

  deviceId   String?
  /// Counter time, as everywhere else in the till.
  occurredAt DateTime
  createdAt  DateTime @default(now())

  shopkeeper ShopkeeperProfile @relation(fields: [shopkeeperId], references: [id], onDelete: Cascade)
  sale       PosSale           @relation(fields: [saleId], references: [id], onDelete: Restrict)
  items      PosReturnItem[]

  @@unique([shopkeeperId, returnNumber])
  @@index([shopkeeperId, occurredAt])
  @@index([saleId])
  @@map("pos_returns")
}

/// One line of a return, tied to the line of the sale it came from.
model PosReturnItem {
  id         String  @id @default(cuid())
  returnId   String
  /// The original line. This is what caps the quantity and fixes the price.
  saleItemId String
  productId  String?
  variantId  String?
  name       String

  quantity   Decimal @db.Decimal(14, 3)
  unit       String  @default("piece")
  /// Copied from the original line, never recomputed from today's price.
  unitPrice  Decimal @db.Decimal(12, 2)
  lineRefund Decimal @db.Decimal(14, 2)

  /// Whether this went back on the shelf. A spoiled or broken return is
  /// refunded but NOT restocked, and the difference is the whole reason
  /// this is a column rather than an assumption.
  restocked Boolean  @default(true)
  /// Where it went instead, when it did not go back on the shelf.
  condition String?
  serials   String[]

  returnRow PosReturn   @relation(fields: [returnId], references: [id], onDelete: Cascade)
  saleItem  PosSaleItem @relation(fields: [saleItemId], references: [id], onDelete: Restrict)

  @@index([returnId])
  @@index([saleItemId])
  @@map("pos_return_items")
}

/// Where a shop buys from.
///
/// Scoped to the shop, not shared across the platform. Two dukas may both
/// buy from "Kevian" and mean different depots, different reps and different
/// credit terms, and merging them into one platform record would make the
/// outstanding balance on this screen meaningless.
model PosSupplier {
  id           String  @id @default(cuid())
  shopkeeperId String
  name         String
  contactName  String?
  phone        String?
  email        String?
  /// Where they deliver from, in words. Not an address lookup: a shopkeeper
  /// writes "Industrial Area" and that is enough to ring them back.
  location     String?
  /// Free text on purpose: "30 days", "cash on delivery", "Fridays only".
  paymentTerms String?
  notes        String?
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shopkeeper ShopkeeperProfile  @relation(fields: [shopkeeperId], references: [id], onDelete: Cascade)
  orders     PosPurchaseOrder[]
  receipts   PosGoodsReceipt[]

  @@unique([shopkeeperId, name])
  @@index([shopkeeperId])
  @@map("pos_suppliers")
}

enum PosPurchaseStatus {
  /// Being written. Nothing is owed and nothing is expected.
  DRAFT
  /// Approved and sent. The shop is now expecting these goods.
  ORDERED
  /// Some of it arrived.
  PART_RECEIVED
  /// All of it arrived.
  RECEIVED
  CANCELLED
}

/// An order placed with a supplier.
///
/// Separate from the platform's existing PurchaseOrder, which belongs to a
/// procurement and tender flow and has no supplier of its own. This one is a
/// shopkeeper telling a depot what to send.
///
/// WHY ORDERING AND RECEIVING ARE DIFFERENT RECORDS
///
/// Because in practice they disagree. A shop orders twenty crates, fourteen
/// arrive on Tuesday and six on Friday, and two of those are broken. An
/// order that doubled as a delivery note would force the shopkeeper to
/// either lie about what came or lose what was promised.
model PosPurchaseOrder {
  id           String @id @default(cuid())
  shopkeeperId String
  supplierId   String
  orderNumber  String

  status PosPurchaseStatus @default(DRAFT)

  /// What the goods come to, before anything is received.
  expectedTotal Decimal   @db.Decimal(14, 2)
  expectedAt    DateTime?
  notes         String?

  createdByUserId String?
  createdByName   String?
  approvedByName  String?
  approvedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shopkeeper ShopkeeperProfile      @relation(fields: [shopkeeperId], references: [id], onDelete: Cascade)
  supplier   PosSupplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  items      PosPurchaseOrderItem[]
  receipts   PosGoodsReceipt[]

  @@unique([shopkeeperId, orderNumber])
  @@index([shopkeeperId, status])
  @@index([supplierId])
  @@map("pos_purchase_orders")
}

model PosPurchaseOrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String?
  /// Kept as text as well, because a supplier's catalogue is not the shop's
  /// and an order may name something before it is a product here.
  name      String
  variantId String?

  quantity Decimal @db.Decimal(14, 3)
  unit     String  @default("piece")
  /// What the shop expects to pay per unit. Receiving may disagree, and the
  /// receipt is what updates cost, not this.
  unitCost Decimal @db.Decimal(12, 2)

  order PosPurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("pos_purchase_order_items")
}

/// Goods actually arriving.
///
/// This is the record that moves stock. An order is a promise; this is the
/// delivery, and it can exist WITHOUT an order, because a shopkeeper who
/// buys three crates off a passing lorry still needs that stock counted.
model PosGoodsReceipt {
  id            String  @id @default(cuid())
  shopkeeperId  String
  supplierId    String?
  orderId       String?
  receiptNumber String

  /// The supplier's own delivery note or invoice number, so the two can be
  /// matched when the bill is queried.
  supplierRef String?
  totalCost   Decimal @db.Decimal(14, 2)
  notes       String?

  receivedByUserId String?
  receivedByName   String?
  occurredAt       DateTime
  createdAt        DateTime @default(now())

  shopkeeper ShopkeeperProfile     @relation(fields: [shopkeeperId], references: [id], onDelete: Cascade)
  supplier   PosSupplier?          @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  order      PosPurchaseOrder?     @relation(fields: [orderId], references: [id], onDelete: SetNull)
  items      PosGoodsReceiptItem[]

  @@unique([shopkeeperId, receiptNumber])
  @@index([shopkeeperId, occurredAt])
  @@index([orderId])
  @@map("pos_goods_receipts")
}

model PosGoodsReceiptItem {
  id          String  @id @default(cuid())
  receiptId   String
  productId   String
  variantId   String?
  /// The order line this fulfils, where there was an order.
  orderItemId String?
  name        String

  quantity Decimal @db.Decimal(14, 3)
  unit     String  @default("piece")
  /// What was ACTUALLY paid per unit. This is what updates the product's
  /// cost and therefore every margin figure downstream.
  unitCost Decimal @db.Decimal(12, 2)

  /// Batch and expiry, captured at the door where they are legible rather
  /// than from a tin at the back of a shelf three weeks later.
  batchNumber String?
  expiryDate  DateTime?

  receipt PosGoodsReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  @@index([receiptId])
  @@map("pos_goods_receipt_items")
}

model PosDevice {
  id           String @id @default(cuid())
  shopkeeperId String
  name         String
  /// "web", "windows", "android", "ios" — free text, because the list will
  /// grow and an enum migration per platform is not worth it.
  platform     String @default("web")
  /// SHA-256 of the pairing token. The plaintext is shown once, at pairing,
  /// and never stored — the same contract as every other credential here.
  tokenHash    String @unique

  lastSeenAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  shopkeeper ShopkeeperProfile @relation(fields: [shopkeeperId], references: [id], onDelete: Cascade)

  @@index([shopkeeperId])
  @@map("pos_devices")
}

/// Someone allowed to operate the till, identified by a PIN at the counter.
///
/// Separate from User on purpose: a shop assistant should be able to ring up
/// a sale without a SAJI account, an email address or a password, and the
/// shopkeeper should be able to revoke them the same afternoon they leave.
/// userId links the row to a real account where one exists.
model PosCashier {
  id           String  @id @default(cuid())
  shopkeeperId String
  userId       String?
  name         String
  /// bcrypt, never the PIN itself. A four-digit PIN is weak by nature, which
  /// is exactly why it must not be recoverable from the database.
  pinHash      String
  /// "cashier" or "manager". A manager may void a sale and close a shift.
  role         String  @default("cashier")
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shopkeeper ShopkeeperProfile @relation(fields: [shopkeeperId], references: [id], onDelete: Cascade)

  @@index([shopkeeperId, isActive])
  @@map("pos_cashiers")
}

/// One sellable unit of a product: a size, a colour, a pack.
///
/// WHY VARIANT STOCK DOES NOT LIVE IN Inventory.
///
/// Inventory is keyed `productId @unique`, and eight call sites across cart,
/// checkout, wholesale and the distributor portal do
/// `inventory.update({ where: { productId } })`. Relaxing that key to
/// (productId, variantId) would break every one of them, for a feature none
/// of them have any concept of. So a variant carries its own figures here,
/// and the product-level Inventory row becomes the SUM of its variants —
/// maintained by the ledger, so the marketplace keeps reading one number per
/// product exactly as it always has and cannot oversell.
///
/// A product with no variants is untouched by any of this: hasVariants stays
/// false, this table stays empty for it, and Inventory remains the truth.
model ProductVariant {
  id           String @id @default(cuid())
  productId    String
  /// The tenant, denormalised, as on every other POS table — so a variant
  /// query filters on one indexed column rather than joining to find out
  /// whose it is.
  shopkeeperId String

  /// What the cashier reads on the button: "Red / M", "500ml", "Size 42".
  /// A single display string rather than a structured size+colour pair,
  /// because the axes differ by trade — shoes have one, clothes two,
  /// paint has colour and tin size — and inventing a schema for all of
  /// them would fit none. `options` holds the structure when it matters.
  label   String
  /// Optional structured form, e.g. { "Size": "M", "Colour": "Red" }, for
  /// grouping the picker into rows. Display never depends on it.
  options Json?

  /// Unique within the shop, like Product.sku and for the same reason.
  sku     String?
  barcode String?

  /// Null means "same as the parent product". Most variants do not differ
  /// in price, and copying the parent's price into every row would mean a
  /// price change had to be written to all of them.
  price     Decimal? @db.Decimal(12, 2)
  costPrice Decimal? @db.Decimal(12, 2)

  /// The exact figure, maintained by lib/pos-ledger.ts. Same contract as
  /// Inventory.stockOnHand: null means no ledger history yet.
  stockOnHand  Decimal? @db.Decimal(14, 3)
  /// floor(stockOnHand), never below zero — the whole-unit figure.
  currentStock Int      @default(0)

  isActive  Boolean  @default(true)
  /// Display order in the till's picker. Sizes are not alphabetical: S, M,
  /// L, XL sorts to L, M, S, XL, which is useless at a counter.
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  stockMovements StockMovement[]
  posSaleItems   PosSaleItem[]
  batches        ProductBatch[]
  serials        ProductSerial[]

  @@unique([shopkeeperId, sku])
  @@index([productId, position])
  @@index([shopkeeperId, barcode])
  @@map("product_variants")
}

/// A delivery of one product, with the date it goes off.
///
/// WHY BATCHES HOLD STOCK RATHER THAN DECORATING IT
///
/// "Forty boxes of amoxicillin" is not a useful figure to a pharmacy. Ten
/// of them expire next month and thirty next year, and which one leaves the
/// shelf is the whole question. So stock lives on the batch, and the
/// variant and product figures above it are sums — the same shape variants
/// already use, one level deeper.
///
/// The till never asks a cashier to pick a batch. The server allocates
/// earliest-expiry-first, because a counter is not the place to make that
/// decision and a human doing it by hand will reach for the front of the
/// shelf every time.
model ProductBatch {
  id           String  @id @default(cuid())
  productId    String
  /// Which size this batch is of, where the product has sizes. A clothes
  /// shop has no batches and a pharmacy has no sizes, but a cosmetics shop
  /// can have both, so the two have to compose rather than exclude.
  variantId    String?
  /// The tenant, denormalised, as on every other POS table.
  shopkeeperId String

  /// What the supplier printed on the box. Free text: lot codes have no
  /// common format and validating them would reject real deliveries.
  batchNumber String?
  /// Null is allowed and means "tracked, but does not expire" — a shop may
  /// want delivery-level traceability on something that never goes off.
  /// Nullable also keeps expiry OPTIONAL for a shop that only wants batches
  /// for recalls.
  expiryDate  DateTime?

  /// Maintained by lib/pos-ledger.ts, same contract as everywhere else:
  /// null means no ledger history yet, not zero.
  stockOnHand  Decimal? @db.Decimal(14, 3)
  currentStock Int      @default(0)
  /// What this delivery cost, which can differ between batches of the same
  /// product — that is most of the reason to track them at all.
  costPrice    Decimal? @db.Decimal(12, 2)

  receivedAt DateTime @default(now())
  /// Retired rather than deleted, like a variant: it is on sale lines and
  /// stock movements that have to stay readable for a recall.
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant        ProductVariant? @relation(fields: [variantId], references: [id])
  stockMovements StockMovement[]
  posSaleItems   PosSaleItem[]

  // The allocation query: this shop's batches of this product, soonest to
  // expire first. Nulls last, because a batch with no expiry should be used
  // after the ones that will go off.
  @@index([shopkeeperId, productId, expiryDate])
  @@index([shopkeeperId, expiryDate])
  @@index([variantId])
  @@map("product_batches")
}

enum SerialStatus {
  IN_STOCK
  SOLD
  RETURNED
  WRITTEN_OFF
}

/// One physical unit, identified by its IMEI or serial number.
///
/// WHY SERIALS DO NOT HOLD STOCK
///
/// Batches and sizes hold stock because they answer "how many"; a serial
/// answers "which one", and there is only ever one of it. Making serials a
/// third ledger holder would mean a stock figure per unit — always 1 or 0 —
/// and a third level of roll-up for no gain.
///
/// So the stock figure stays where it is, and this is a REGISTER beside it:
/// receiving serials adds stock through the normal path, selling one marks
/// it sold. The two can in principle disagree, which is why getSerialDrift
/// in lib/actions/pos-stock.ts compares them and says so, exactly as the
/// ledger-versus-projection check does.
model ProductSerial {
  id           String       @id @default(cuid())
  productId    String
  variantId    String?
  shopkeeperId String
  /// The IMEI, serial or certificate number. Unique per shop: two shops may
  /// legitimately both hold a unit whose number was reused by a
  /// manufacturer, but one shop holding two of the same number is an error
  /// worth refusing at the point of entry.
  serial       String
  status       SerialStatus @default(IN_STOCK)

  /// Which sale it went out on. Kept after a return so the history reads
  /// "sold on this receipt, came back on that one" rather than going blank.
  posSaleItemId String?
  soldAt        DateTime?

  /// What this specific unit cost, which for a phone shop can differ unit
  /// to unit in a way the product's cost price cannot express.
  costPrice Decimal? @db.Decimal(12, 2)
  note      String?

  receivedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id])

  @@unique([shopkeeperId, serial])
  @@index([shopkeeperId, productId, status])
  @@index([posSaleItemId])
  @@map("product_serials")
}

/// One entry in a shop's controlled-substances register.
///
/// WHAT THIS IS, AND WHAT IT IS NOT
///
/// It is a record that a particular quantity of a particular product went
/// to a particular named person on a particular date, written at the moment
/// of sale and never edited afterwards. That is what a pharmacy or agrovet
/// is asked to keep, and what an inspector asks to see.
///
/// It is NOT a claim of regulatory compliance. Kenya's Pharmacy and Poisons
/// Board and the Veterinary Medicines Directorate each set their own
/// requirements for what a register must contain, how long it is kept and
/// who may sign it, and those requirements change. This holds the fields a
/// shop told us to hold. Whether that satisfies a particular regulator is a
/// question for that regulator, and the UI says so rather than implying
/// otherwise.
///
/// Append-only by convention and by the absence of any update path: there is
/// no action anywhere in this codebase that edits one of these rows. A
/// correction is a VOIDED sale, which leaves both entries readable.
model ControlledSaleRecord {
  id            String  @id @default(cuid())
  shopkeeperId  String
  /// The sale line this entry is for. Nullable only so a voided sale whose
  /// line was removed cannot orphan the register entry.
  posSaleItemId String?
  posSaleId     String?

  /// Snapshotted, not joined. A register read three years from now must not
  /// depend on a product row still existing under the same name.
  productName  String
  variantLabel String?
  batchNumber  String?
  serials      String[]
  quantity     Decimal  @db.Decimal(14, 3)
  unit         String   @default("piece")

  /// Who took it away.
  buyerName     String
  buyerIdNumber String?
  buyerPhone    String?

  /// Who authorised it, where a prescription was involved. Optional because
  /// not every controlled product is prescription-only.
  prescriberName  String?
  prescriptionRef String?

  /// Who served, by name as well as id — the id is useless in an export
  /// once the staff member has left.
  recordedByUserId String?
  recordedByName   String?

  /// When it happened at the counter, not when the server heard. Same rule
  /// as every other POS timestamp.
  occurredAt DateTime
  createdAt  DateTime @default(now())

  shopkeeper ShopkeeperProfile @relation(fields: [shopkeeperId], references: [id], onDelete: Cascade)

  @@index([shopkeeperId, occurredAt])
  @@index([shopkeeperId, productName])
  @@index([posSaleId])
  @@map("controlled_sale_records")
}
