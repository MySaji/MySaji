enum BannerPlacement {
  HOME_HERO
  SERVICES_TOP
  PRODUCTS_TOP
}

/// Admin-curated promotional banners — a real merchandising CMS (image,
/// headline, link, schedule), not derived from product/order data. Separate
/// from Promotion (a shopkeeper's discount-code system) — unrelated concepts
/// that happen to share the word "promo".
model Banner {
  id          String          @id @default(cuid())
  title       String
  subtitle    String?
  imageUrl    String
  linkUrl     String?
  placement   BannerPlacement @default(HOME_HERO)
  sortOrder   Int             @default(0)
  isActive    Boolean         @default(true)
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  createdById String?

  createdBy User? @relation(fields: [createdById], references: [id])

  @@index([placement, isActive])
  @@map("banners")
}

/// One person blocking another in chat. Directional on purpose: blocking
/// stops them writing to you, it does not stop you writing to them, and it
/// says nothing about what the other person can see elsewhere in the app.
/// Distinct from BlockedClient, which is a provider refusing a customer's
/// bookings — a commercial decision, not a messaging one.
model ChatBlock {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("ChatBlockBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("ChatBlockBlocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
  @@map("chat_blocks")
}

/// A message the platform's own rules flagged when it was sent — asking for a
/// phone number, steering payment off Saji, and so on.
///
/// Recorded rather than blocked: the patterns are heuristics (see
/// lib/policy-violations.ts) and refusing to deliver a message on a guess
/// would break real conversations. The message goes through; the flag gives
/// admins something to act on, and repeat offenders surface by count.
model PolicyViolation {
  id        String         @id @default(cuid())
  userId    String
  messageId String?
  kind      ViolationKind
  severity  ReportSeverity @default(MEDIUM)
  /// The matched fragment, not the whole message — enough for an admin to
  /// judge it without copying private conversation wholesale.
  excerpt   String
  reviewed  Boolean        @default(false)
  createdAt DateTime       @default(now())

  user User @relation("PolicyViolationUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([reviewed])
  @@map("policy_violations")
}

model ContentReport {
