  targetType      ReportTargetType
  targetId        String
  contentSnapshot String
  reportedUserId  String?
  reporterId      String?
  reason          String
  severity        ReportSeverity   @default(MEDIUM)
  status          ReportStatus     @default(PENDING)
  createdAt       DateTime         @default(now())
  resolvedAt      DateTime?
  resolvedById    String?

  reportedUser User? @relation("ContentReportSubject", fields: [reportedUserId], references: [id])
  reporter     User? @relation("ContentReportReporter", fields: [reporterId], references: [id])
  resolvedBy   User? @relation("ContentReportResolver", fields: [resolvedById], references: [id])

  @@index([targetType, targetId])
  @@index([status])
  @@map("content_reports")
}

