# Copy to .env and configure the integrations you use. Never commit .env.
# Payment simulation is explicitly opt-in and is always disabled in production.
# Trust proxy headers only when your ingress strips client-supplied values.
AIRTEL_API_KEY=
AIRTEL_API_SECRET=
ALLOW_PAYMENT_SIMULATION=false
ANTHROPIC_API_KEY=
AUTH_SECRET=
CALLBACK_URL=http://localhost:3000
CRON_SECRET=
DATABASE_URL=
DIRECT_URL=
ETIMS_BASE_URL=
ETIMS_INIT_PATH=
ETIMS_SALES_PATH=
ETIMS_SANDBOX_BASE_URL=
ETIMS_SANDBOX_VERIFY_URL=
ETIMS_TIMEOUT_MS=15000
ETIMS_VERIFY_URL=
GEMINI_API_KEY=
# Optional text model override for owner-reviewed business website drafts.
POS_WEBSITE_MODEL=gemini-3.6-flash
POS_WEBSITE_FALLBACK_MODEL=gemini-3.5-flash-lite
# Optional override for product-photo background and studio edits.
POS_IMAGE_MODEL=gemini-nano-banana-2.1
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
INFOBIP_2FA_APPLICATION_ID=
INFOBIP_2FA_MESSAGE_ID=
INFOBIP_API_KEY=
INFOBIP_BASE_URL=
MPESA_B2C_CERT=
MPESA_B2C_COMMAND_ID=
MPESA_B2C_SHORTCODE=
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_ENVIRONMENT=sandbox
MPESA_INITIATOR_NAME=
MPESA_INITIATOR_PASSWORD=
MPESA_PASSKEY=
MPESA_SHORTCODE=
# Production deployment on the main domain: https://mysaji.com
# Leave empty locally; callbacks must reach the deployment using this database.
MPESA_CALLBACK_ORIGIN=
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_SENTRY_DSN=
# Canonical origin. Production: https://mysaji.com; staging must be access-restricted.
NEXT_PUBLIC_SITE_URL=https://mysaji.com
# Optional public GTM ID; blank disables analytics and the consent UI. Rebuild after changes.
NEXT_PUBLIC_GTM_ID=
# Optional URL-prefix verification only; Domain property uses DNS TXT instead.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
NEXT_STANDALONE=
PAYMENT_METHOD_ENCRYPTION_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox
PLATFORM_BANK_ACCOUNT_NAME=
PLATFORM_BANK_ACCOUNT_NUMBER=
PLATFORM_BANK_NAME=
SENTRY_AUTH_TOKEN=
SENTRY_DSN=
SMTP_FROM=
SMTP_HOST=
SMTP_PASS=
SMTP_PORT=587
SMTP_USER=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
TRUST_PROXY_HEADERS=false
TURN_CREDENTIAL=
TURN_URL=
TURN_USERNAME=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
TURN_SHARED_SECRET=

# Explicit settlement conversion for newly initiated PayPal orders; review operationally.
PAYPAL_KES_TO_USD_RATE=

# Canonical Auth.js origin; NEXTAUTH_URL remains supported for compatibility.
AUTH_URL=
# Only enable behind an ingress you trust to overwrite forwarding headers.
AUTH_TRUST_HOST=

# Tests never fall back to the application database. Use a local disposable _test or _ci database.
SAJI_TEST_DATABASE_URL=
SAJI_BROWSER_BASE_URL=http://localhost:3100
